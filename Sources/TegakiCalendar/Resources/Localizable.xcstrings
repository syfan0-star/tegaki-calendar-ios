    "toast.weekStart.adopted.monday" : {
      "comment" : "トースト（6 秒、3 行まで）。英語 Week start set to Monday to match your iCloud handwriting. You can change it in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenstart auf Montag gesetzt, passend zu Ihrer iCloud-Handschrift. Sie können das in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Week start set to Monday to match your iCloud handwriting. You can change it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semana empieza en lunes según su escritura a mano de iCloud. Puede cambiarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaines réglées sur lundi selon votre écriture dans iCloud. Vous pouvez le changer dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settimane impostate su lunedì in base alla scrittura in iCloud. Può cambiarlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud の手書きに合わせて、週の始まりを月曜にしました。設定で変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud의 손글씨에 맞춰 한 주의 첫째 날을 월요일로 설정했어요. 설정에서 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semanas ajustadas para segunda-feira conforme sua escrita no iCloud. Você pode mudar isso em Ajustes."
