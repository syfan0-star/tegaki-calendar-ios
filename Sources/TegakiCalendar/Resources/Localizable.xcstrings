        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지우개로 선을 지우고 손가락을 떼면 직전의 펜이나 마커로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de apagar um traço com a borracha e levantar o dedo, você volta à caneta ou ao marcador usado logo antes."
