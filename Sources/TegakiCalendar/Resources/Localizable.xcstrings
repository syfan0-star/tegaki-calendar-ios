            "value" : "Commencer les semaines le lundi ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniziare le settimane di lunedì?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週の始まりを月曜にしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 주의 첫째 날을 월요일로 설정할까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar as semanas na segunda-feira?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
