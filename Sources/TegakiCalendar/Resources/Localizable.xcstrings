    "toolbar.dock.hint.toLeft" : {
      "comment" : "丸ボタンが右下にあるときの読み上げのヒント（toolbar.moveEdge.toLeft と toolbar.pin の語で）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten, um nach unten links zu verschieben oder die Werkzeugleiste immer anzuzeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold to move to the bottom left or to always show the toolbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga pulsado para mover abajo a la izquierda o mostrar siempre la barra de herramientas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt pour déplacer en bas à gauche ou toujours afficher la barre d’outils"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenga premuto per spostare in basso a sinistra o mostrare sempre la barra degli strumenti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しで、左下へ移すか、ツールバーをいつも出すかを選べます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 누르면 왼쪽 아래로 옮기거나 도구 막대를 항상 표시할 수 있어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado para mover para o canto inferior esquerdo ou exibir sempre a barra de ferramentas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按可移到左下角，或让工具栏一直显示"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按可移到左下角，或讓工具列一直顯示"
          }
        }
      }
    },
    "toolbar.dock.hint.toRight" : {
      "comment" : "丸ボタンが左下にあるときの読み上げのヒント（toolbar.moveEdge.toRight と toolbar.pin の語で）",
