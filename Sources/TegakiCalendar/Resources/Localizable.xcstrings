    "settings.input.allowFinger.footer" : {
      "comment" : "上のスイッチの説明",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, können Sie auch mit dem Finger Linien ziehen. Wenn es deaktiviert ist, scrollen und tippen Sie mit dem Finger. Handschrift eignet sich am besten für iPad und Apple Pencil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is on, you can also draw lines with your finger. When it is off, your finger scrolls and taps. Handwriting works best with iPad and Apple Pencil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, también puede trazar líneas con el dedo. Si está desactivado, el dedo sirve para desplazarse y tocar. La escritura a mano funciona mejor con iPad y Apple Pencil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, vous pouvez aussi tracer des traits avec le doigt. Si elle est désactivée, le doigt sert à faire défiler et à toucher. L’écriture manuscrite convient surtout à l’iPad avec l’Apple Pencil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, può tracciare linee anche con il dito. Se è disattivo, il dito serve per scorrere e toccare. La scrittura a mano è ideale con iPad e Apple Pencil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると指でも線が引けます。オフのときは指でスクロールとタップをします。手書きは iPad と Apple Pencil で書くのに向いています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 손가락으로도 선을 그을 수 있어요. 끄면 손가락으로 스크롤과 탭을 해요. 손글씨는 iPad와 Apple Pencil로 쓰기에 알맞아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, você também pode traçar linhas com o dedo. Quando desativado, o dedo serve para rolar e tocar. A escrita à mão funciona melhor com iPad e Apple Pencil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，也可以用手指画线。关闭时，手指用于滚动和轻点。手写最适合使用 iPad 和 Apple Pencil。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，也可以用手指畫線。關閉時，手指用於捲動和點一下。手寫最適合使用 iPad 和 Apple Pencil。"
          }
        }
      }
    },
    "settings.input.eraseAfterConvert" : {
      "comment" : "スイッチの名前",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
