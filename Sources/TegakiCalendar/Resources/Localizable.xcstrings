    "settings.input.eraseAfterConvert.footer" : {
      "comment" : "上のスイッチの説明",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorauswahl dafür, ob mit dem Lasso umkreiste Handschrift gelöscht wird, nachdem daraus ein Termin erstellt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The starting choice for whether to erase handwriting that you circled with the lasso after you make it into an event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción inicial para borrar o no la escritura a mano rodeada con el lazo después de convertirla en evento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choix de départ pour effacer ou non l’écriture manuscrite entourée au lasso une fois changée en évènement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scelta iniziale per cancellare o no la scrittura a mano cerchiata con il lazo dopo averla trasformata in evento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投げなわで囲んだ手書きを予定にしたあと、その手書きを消すかどうかの初期値です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올가미로 둘러싼 손글씨를 일정으로 만든 뒤에 그 손글씨를 지울지 정하는 기본값이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção inicial para apagar ou não a escrita à mão circulada com o laço depois de transformá-la em evento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用套索圈选的手写内容转为日程后，是否将其抹掉的初始选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用套索圈選的手寫內容轉為行程後，是否將其清除的初始選擇。"
          }
        }
      }
    },
    "settings.input.eraserAutoReturn.footer.pad" : {
      "comment" : "上のスイッチの説明（iPad）。ダブルタップ・スクイーズで選んだ消しゴムも「戻る」という意味（戻らないのではない）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einen Strich radieren und den Finger oder den Apple Pencil anheben, kehrt das Werkzeug zum zuvor genutzten Stift oder Marker zurück. Das gilt auch für den Radierer, den Sie durch Doppeltippen oder Drücken des Apple Pencil gewählt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you erase a line with the eraser and lift your finger or Apple Pencil, the tool returns to the pen or marker you used just before. The same is true of an eraser you chose by double-tapping or squeezing Apple Pencil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al borrar un trazo con la goma y levantar el dedo o el Apple Pencil, se vuelve a la pluma o al marcador que usaba justo antes. Lo mismo ocurre con la goma elegida con el doble toque o el gesto de apretar del Apple Pencil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois un trait effacé avec la gomme, quand vous levez le doigt ou l’Apple Pencil, l’outil revient au stylo ou au feutre utilisé juste avant. C’est aussi le cas de la gomme choisie par double toucher ou pincement de l’Apple Pencil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver cancellato un tratto con la gomma e sollevato il dito o Apple Pencil, si torna alla penna o al marker usato poco prima. Vale anche per la gomma scelta con il doppio tocco o la pressione di Apple Pencil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消しゴムで線を消して指や Apple Pencil を離すと、直前のペンかマーカーに戻ります。Apple Pencil のダブルタップやスクイーズで選んだ消しゴムも同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지우개로 선을 지우고 손가락이나 Apple Pencil을 떼면 직전의 펜이나 마커로 돌아가요. Apple Pencil의 두 번 탭이나 스퀴즈로 선택한 지우개도 마찬가지예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de apagar um traço com a borracha e levantar o dedo ou o Apple Pencil, você volta à caneta ou ao marcador usado logo antes. O mesmo vale para a borracha escolhida com o toque duplo ou com o gesto de apertar do Apple Pencil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用橡皮擦擦除线条并抬起手指或 Apple Pencil 后，会回到刚才使用的钢笔或马克笔。通过轻点两下或轻捏 Apple Pencil 选择的橡皮擦也是如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用橡皮擦擦除線條並抬起手指或 Apple Pencil 後，會回到剛才使用的鋼筆或麥克筆。透過點兩下或擠壓 Apple Pencil 選擇的橡皮擦也是如此。"
          }
        }
      }
    },
    "settings.input.eraserAutoReturn.footer.phone" : {
      "comment" : "上のスイッチの説明（iPhone）。**どの言語でも Apple Pencil と iPad を書かない**",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einen Strich radieren und den Finger anheben, kehrt das Werkzeug zum zuvor genutzten Stift oder Marker zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you erase a line with the eraser and lift your finger, the tool returns to the pen or marker you used just before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al borrar un trazo con la goma y levantar el dedo, se vuelve a la pluma o al marcador que usaba justo antes."
          }
