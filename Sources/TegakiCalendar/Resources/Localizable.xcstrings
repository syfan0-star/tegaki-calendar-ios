    "toolbar.fingerToggle" : {
      "comment" : "ツールバーのスイッチの名前。13 pt で縮めない。ja の幅 ＋ 76 pt（約 136 pt、10.5 em）まで（F-13）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Finger zeichnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw with Finger"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujar con el dedo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrire au doigt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con il dito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指でも書く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락으로 쓰기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traçar com o dedo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指书写"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指書寫"
          }
        }
      }
    },
    "toolbar.fingerToggle.hint" : {
      "comment" : "同じスイッチの読み上げのヒント",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, können Sie auch mit dem Finger Linien ziehen. Wenn es deaktiviert ist, scrollen und tippen Sie mit dem Finger"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is on, you can also draw lines with your finger. When it is off, your finger scrolls and taps"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, también puede trazar líneas con el dedo. Si está desactivado, el dedo sirve para desplazarse y tocar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, vous pouvez aussi tracer des traits avec le doigt. Si elle est désactivée, le doigt sert à faire défiler et à toucher"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, può tracciare linee anche con il dito. Se è disattivo, il dito serve per scorrere e toccare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると指でも線が引けます。オフのときは指でスクロールとタップをします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 손가락으로도 선을 그을 수 있어요. 끄면 손가락으로 스크롤과 탭을 해요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, você também pode traçar linhas com o dedo. Quando desativado, o dedo serve para rolar e tocar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，也可以用手指画线。关闭时，手指用于滚动和轻点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，也可以用手指畫線。關閉時，手指用於捲動和點一下"
          }
        }
      }
    },
    "toolbar.hint.eraser" : {
      "comment" : "消しゴムを選んでいるときの説明。ツールバーの説明。12 pt。改行は 1 つまで（改行の無い訳もよい）。各行は 144 pt 以内（F-14）。入らないときは省略より短い言い換えを",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht berührte Striche"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erases lines you touch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el trazo tocado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le trait touché"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella i tratti toccati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れた線をまるごと消します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닿은 선을 통째로 지워요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o traço tocado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擦除碰到的整条线"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擦除碰到的整條線"
          }
        }
      }
    },
    "toolbar.hint.eraser.toMarker" : {
      "comment" : "消しゴムの説明で、消したらマーカーに戻るとき。2 行で、1 行目は toolbar.hint.eraser と同じ文にする。ツールバーの説明。12 pt。改行は 1 つまで（改行の無い訳もよい）。各行は 144 pt 以内（F-14）。入らないときは省略より短い言い換えを",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht berührte Striche\n(danach wieder Marker)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erases lines you touch\n(then back to marker)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el trazo tocado\n(y vuelve al marcador)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le trait touché\n(puis retour au feutre)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella i tratti toccati\n(poi torna al marker)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触れた線をまるごと消します\n（消すとマーカーに戻ります）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닿은 선을 통째로 지워요\n(지우면 마커로 돌아가요)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o traço tocado\n(e volta ao marcador)"
          }
