    "settings.purchase.footer.readOnly" : {
      "comment" : "購入の節の説明（閲覧専用のとき）。%@ は閲覧専用の理由の 1 文（kit.plan.note.*。句点で終わる）で、この文の前につなぐ。語の間に空白を置く言語は %@ の後ろに空白を入れる。利用規約の第 5 条 5 項と同じ一覧",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@閲覧専用では、予定と手書きの閲覧、ページ移動、拡大、iCloud からの受信、この端末の手書きを全て消す、手書きの書き出し、設定の変更ができます。新しく書く・消す・動かす、予定の作成・編集、Web 版からの取り込みは購読すると使えます。"
          }
        }
      }
    },
