    "export.pdf.note" : {
      "comment" : "2 つ目の選択肢の説明",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt aus der geöffneten Seite (%1$@ · %2$@) ein einseitiges PDF. Papier, Termine, Feiertage und Handschrift erscheinen wie auf dem Bildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes a one-page PDF of the page that is open (%1$@ · %2$@). The paper, events, holidays and handwriting appear as they do on the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF de una hoja con la página abierta (%1$@ · %2$@). El papel, los eventos, los días festivos y la escritura a mano aparecen como en la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un PDF d’une page à partir de la page ouverte (%1$@ · %2$@). Le papier, les évènements, les jours fériés et l’écriture manuscrite apparaissent comme à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un PDF di un foglio con la pagina aperta (%1$@ · %2$@). Carta, eventi, festività e scrittura a mano appaiono come sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま開いているページ（%1$@・%2$@）を 1 枚の PDF にします。紙・予定・祝日・手書きが画面のとおりに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 열려 있는 페이지(%1$@ · %2$@)를 PDF 1장으로 만들어요. 종이, 일정, 공휴일, 손글씨가 화면 그대로 들어가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um PDF de uma folha com a página aberta (%1$@ · %2$@). O papel, os eventos, os feriados e a escrita à mão aparecem como na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前打开的页面（%1$@ · %2$@）制作成一页 PDF。纸张、日程、节假日和手写内容会按屏幕所示呈现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將目前開啟的頁面（%1$@ · %2$@）製作成一頁 PDF。紙張、行程、假日和手寫內容會依螢幕所示呈現。"
          }
        }
      }
    },
