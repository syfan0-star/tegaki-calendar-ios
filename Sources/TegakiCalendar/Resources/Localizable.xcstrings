    "sync.footer.accountMismatch" : {
      "comment" : "設定の「同期」の節の脚注。「新しいアカウントで使い始める」は設定の画面のボタンの語と同じに（U のキー）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handschrift auf diesem Gerät gehört zu dem iCloud-Account, der zuvor synchronisiert wurde. Treffen Sie Ihre Wahl unter „Mit dem neuen Account beginnen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The handwriting on this device belongs to the iCloud account it synced with before. Choose from “Start with the New Account”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escritura a mano de este dispositivo pertenece a la cuenta de iCloud que se sincronizaba antes. Elija en “Empezar con la cuenta nueva”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écriture manuscrite de cet appareil appartient au compte iCloud synchronisé auparavant. Faites votre choix dans « Commencer avec le nouveau compte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scrittura a mano su questo dispositivo appartiene all’account iCloud sincronizzato in precedenza. Scelga da “Inizia con il nuovo account”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の手書きは、前に同期していた iCloud アカウントのものです。「新しいアカウントで使い始める」から選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 손글씨는 이전에 동기화하던 iCloud 계정의 것이에요. ‘새 계정으로 시작하기’에서 선택해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escrita à mão deste dispositivo pertence à conta do iCloud sincronizada antes. Escolha em “Começar com a conta nova”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的手写内容属于之前同步的 iCloud 账户。请从“使用新账户开始”中选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部裝置上的手寫內容屬於先前同步的 iCloud 帳號。請從「使用新帳號開始」中選擇。"
          }
        }
      }
    },
    "sync.footer.noAccount" : {
      "comment" : "設定の「同期」の節の脚注。",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich bei iCloud an, um mit Ihren anderen Geräten zu synchronisieren. Ihre Handschrift wird nur auf diesem Gerät gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to iCloud to sync with your other devices. Your handwriting is saved only on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sesión en iCloud para sincronizar con sus otros dispositivos. Su escritura a mano se guarda solo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
