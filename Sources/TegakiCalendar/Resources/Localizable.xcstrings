          "stringUnit" : {
            "state" : "translated",
            "value" : "前後の週が横につながりました。2 本指で横にすべらせると、となりの週が出てきます。境目をまたいで、そのまま書けます。"
          }
        }
      }
    },
    "prototype.span.guide.week.pencil" : {
