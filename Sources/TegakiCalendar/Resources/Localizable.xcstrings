    "onboarding.account.text" : {
      "comment" : "初回案内の 1 枚目。「カレンダー」は iOS のカレンダーアプリの名前。%@ に設定の画面と同じ手順（settings の Google の手順の文）が入る。空行を 1 つ空ける",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App zeigt die Termine aus der App „Kalender“ auf diesem Gerät an.\n\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app shows the events in the Calendar app on this device.\n\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app muestra los eventos de la app Calendario de este dispositivo.\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app affiche les évènements de l’app Calendrier de cet appareil.\n\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app mostra gli eventi dell’app Calendario di questo dispositivo.\n\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、この端末の「カレンダー」に入っている予定を表示します。\n\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 이 기기의 ‘캘린더’에 있는 일정을 표시해요.\n\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app exibe os eventos do app Calendário deste dispositivo.\n\n%@"
          }
        },
        "zh-Hans" : {
