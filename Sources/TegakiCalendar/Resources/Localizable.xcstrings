    "settings.purchase.footer.cancel" : {
      "comment" : "購入の節の説明（購読中）。%@ は iOS の画面の道順（kit.plan.cancelPath）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündigen können Sie auf Ihrem Gerät unter %@. Nach der Kündigung können Sie die App bis zum Ende des Zeitraums nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To cancel, go to %@ on your device. After you cancel, you can keep using the app until the end of the period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cancelar, vaya a %@ en su dispositivo. Tras cancelar, puede usar la app hasta el final del periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour résilier, allez dans %@ sur votre appareil. Après la résiliation, vous pouvez utiliser l’app jusqu’à la fin de la période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per disdire, vada in %@ sul dispositivo. Dopo la disdetta, può usare l’app fino alla fine del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約は端末の%@から。解約しても期間の終わりまで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해지는 기기의 %@에서 할 수 있어요. 해지해도 기간이 끝날 때까지 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cancelar, acesse %@ no seu dispositivo. Depois de cancelar, você pode usar o app até o fim do período."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需取消，请前往设备上的%@。取消后，你仍可使用到当前周期结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需取消，請前往裝置上的%@。取消後，仍可使用到期間結束。"
          }
        }
      }
    },
    "settings.purchase.footer.grace" : {
      "comment" : "購入の節の説明（請求に問題があり、猶予の期間のとき）。%@ は iOS の画面の道順（kit.plan.paymentPath）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt ein Problem mit Ihrer Zahlung. Prüfen Sie Ihre Zahlungsmethode auf Ihrem Gerät unter %@. Bis zum Ende der Nachfrist können Sie die App nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a problem with your payment. Check your payment method in %@ on your device. You can keep using the app until the grace period ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un problema con su pago. Compruebe su método de pago en %@ en su dispositivo. Puede usar la app hasta el final del periodo de gracia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a un problème de paiement. Vérifiez votre mode de paiement dans %@ sur votre appareil. Vous pouvez utiliser l’app jusqu’à la fin du délai de grâce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è un problema con il pagamento. Verifichi il metodo di pagamento in %@ sul dispositivo. Può usare l’app fino alla fine del periodo di tolleranza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払いに問題があります。端末の%@でお支払い方法を確認してください。猶予の期限までは使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제에 문제가 있어요. 기기의 %@에서 결제 방법을 확인해 주세요. 유예 기간이 끝날 때까지는 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um problema no seu pagamento. Confira a forma de pagamento em %@ no seu dispositivo. Você pode usar o app até o fim do período de carência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的付款有问题。请在设备上的%@中确认付款方式。宽限期结束前你仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的付款有問題。請在裝置上的%@中確認付款方式。寬限期結束前仍可使用。"
          }
        }
      }
    },
    "settings.purchase.footer.readOnly" : {
      "comment" : "購入の節の説明（閲覧専用のとき）。%@ は閲覧専用の理由の 1 文（kit.plan.note.*。句点で終わる）で、この文の前につなぐ。語の間に空白を置く言語は %@ の後ろに空白を入れる。利用規約の第 5 条 5 項と同じ一覧",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Im Modus „Nur ansehen“ können Sie Termine und Handschrift ansehen, Seiten wechseln, zoomen, aus iCloud empfangen, alle Handschrift auf diesem Gerät löschen, Handschrift exportieren und Einstellungen ändern. Mit einem Abo können Sie schreiben, radieren und verschieben, Termine erstellen und bearbeiten und aus der Web-Version importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ In View Only, you can view events and handwriting, move between pages, zoom, receive from iCloud, erase all handwriting on this device, export handwriting and change settings. Subscribe to write, erase or move handwriting, to create or edit events, and to import from the Web version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ En solo lectura, puede ver eventos y escritura a mano, cambiar de página, ampliar, recibir de iCloud, borrar toda la escritura a mano de este dispositivo, exportarla y cambiar los ajustes. Suscríbase para escribir, borrar o mover, crear o editar eventos e importar de la versión web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ En lecture seule, vous pouvez voir les évènements et l’écriture manuscrite, changer de page, zoomer, recevoir depuis iCloud, effacer toute l’écriture manuscrite de cet appareil, l’exporter et modifier les réglages. Abonnez-vous pour écrire, effacer ou déplacer, créer ou modifier des évènements et importer depuis la version web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ In sola lettura può vedere eventi e scrittura a mano, cambiare pagina, ingrandire, ricevere da iCloud, cancellare tutta la scrittura a mano su questo dispositivo, esportarla e cambiare le impostazioni. Si abboni per scrivere, cancellare o spostare, creare o modificare eventi e importare dalla versione web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@閲覧専用では、予定と手書きの閲覧、ページ移動、拡大、iCloud からの受信、この端末の手書きを全て消す、手書きの書き出し、設定の変更ができます。新しく書く・消す・動かす、予定の作成・編集、Web 版からの取り込みは購読すると使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 보기 전용에서는 일정과 손글씨 보기, 페이지 이동, 확대, iCloud에서 받기, 이 기기의 손글씨 모두 지우기, 손글씨 내보내기, 설정 변경을 할 수 있어요. 새로 쓰기, 지우기, 옮기기, 일정 만들기와 편집, 웹 버전에서 가져오기는 구독하면 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Em somente leitura, você pode ver eventos e escrita à mão, mudar de página, ampliar, receber do iCloud, apagar toda a escrita à mão deste dispositivo, exportá-la e mudar os ajustes. Assine para escrever, apagar ou mover, criar ou editar eventos e importar da versão web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@仅查看时，可以查看日程和手写内容、翻页、缩放、从 iCloud 接收、抹掉此设备上的所有手写内容、导出手写内容和更改设置。订阅后可以书写、擦除和移动手写内容，创建和编辑日程，以及从网页版导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@僅檢視時，可以檢視行程和手寫內容、換頁、縮放、從 iCloud 接收、清除這部裝置上的所有手寫內容、匯出手寫內容和更改設定。訂閱後可以書寫、擦除和移動手寫內容，製作和編輯行程，以及從網頁版匯入。"
          }
        }
      }
    },
    "settings.purchase.footer.trial" : {
      "comment" : "購入の節の説明（試用中）。%@ は iOS の画面の道順（kit.plan.cancelPath）。前半は settings.purchase.footer.cancel と同じ文に",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kündigen können Sie auf Ihrem Gerät unter %@. Nach der Kündigung können Sie die App bis zum Ende des Zeitraums nutzen. Wenn Sie während der Testphase kündigen, fallen keine Kosten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To cancel, go to %@ on your device. After you cancel, you can keep using the app until the end of the period. If you cancel during the free trial, you are not charged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cancelar, vaya a %@ en su dispositivo. Tras cancelar, puede usar la app hasta el final del periodo. Si cancela durante la prueba, no se le cobra nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour résilier, allez dans %@ sur votre appareil. Après la résiliation, vous pouvez utiliser l’app jusqu’à la fin de la période. Si vous résiliez pendant l’essai, rien ne vous est facturé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per disdire, vada in %@ sul dispositivo. Dopo la disdetta, può usare l’app fino alla fine del periodo. Se disdice durante la prova, non paga nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約は端末の%@から。解約しても期間の終わりまで使えます。試用中に解約すれば料金はかかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해지는 기기의 %@에서 할 수 있어요. 해지해도 기간이 끝날 때까지 쓸 수 있어요. 체험 중에 해지하면 요금이 청구되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cancelar, acesse %@ no seu dispositivo. Depois de cancelar, você pode usar o app até o fim do período. Se cancelar durante o teste, nada será cobrado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需取消，请前往设备上的%@。取消后，你仍可使用到当前周期结束。在试用期间取消不会收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需取消，請前往裝置上的%@。取消後，仍可使用到期間結束。在試用期間取消不會收費。"
          }
        }
      }
    },
