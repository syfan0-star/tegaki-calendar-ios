    "settings.weekStart.footer" : {
      "comment" : "週の始まりの節の説明。英語 Automatic follows your device region. This setting is per device. Use the same setting on each device to see the same week handwriting.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ folgt der Region des Geräts. Diese Einstellung gilt pro Gerät. Verwenden Sie auf jedem Gerät dieselbe Einstellung, um dieselbe Handschrift auf den Wochenseiten zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic follows your device region. This setting is per device. Use the same setting on each device to see the same week handwriting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue la región del dispositivo. Este ajuste es propio de cada dispositivo. Use el mismo ajuste en todos para ver la misma escritura a mano en las semanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit la région de l’appareil. Ce réglage est propre à chaque appareil. Utilisez le même réglage partout pour voir la même écriture manuscrite dans les semaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico segue la zona del dispositivo. Questa impostazione vale per ogni singolo dispositivo. Usi la stessa impostazione su tutti per vedere la stessa scrittura a mano nelle settimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動は端末の地域に合わせます（日本は月曜）。この設定は端末ごとです。週の手書きをどの端末でも見られるように、同じ設定にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 기기의 지역을 따라요. 이 설정은 기기마다 따로 저장해요. 어느 기기에서나 같은 주 손글씨를 보려면 같은 설정으로 맞춰 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático segue a região do dispositivo. Este ajuste é de cada dispositivo. Use o mesmo ajuste em todos para ver a mesma escrita à mão nas semanas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会跟随设备的地区。此设置按设备分别保存。若要在每台设备上看到相同的周手写内容，请使用相同的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會依照裝置的地區。此設定依裝置分別儲存。若要在每部裝置上看到相同的週手寫內容，請使用相同的設定。"
          }
        }
      }
    },
