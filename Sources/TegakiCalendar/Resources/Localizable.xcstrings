    "settings.data.importFooter" : {
      "comment" : "データの節の説明。「手書きを書き出す（iPad アプリ用）」は Web 版の機能の名前で、Web 版は日本語だけなので、訳の中でも括弧で日本語のまま添える（§6.2）",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie in den Einstellungen der Web-Version „手書きを書き出す（iPad アプリ用）“ (Handschrift für die iPad-App exportieren) und wählen Sie dann diese Datei. Wird dieselbe Datei zweimal importiert, wird die Handschrift nicht verdoppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the settings of the Web version, use “手書きを書き出す（iPad アプリ用）” (export handwriting for the iPad app), then choose that file. Importing the same file twice does not duplicate your handwriting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los ajustes de la versión web, use “手書きを書き出す（iPad アプリ用）” (exportar la escritura a mano para la app de iPad) y luego elija ese archivo. Si importa dos veces el mismo archivo, la escritura a mano no se duplica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les réglages de la version web, utilisez « 手書きを書き出す（iPad アプリ用） » (exporter l’écriture manuscrite pour l’app iPad), puis choisissez ce fichier. Importer deux fois le même fichier ne double pas l’écriture manuscrite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle impostazioni della versione web, usi “手書きを書き出す（iPad アプリ用）” (esporta la scrittura a mano per l’app per iPad), poi scelga quel file. Importando due volte lo stesso file, la scrittura a mano non viene duplicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web 版の設定で「手書きを書き出す（iPad アプリ用）」をして、そのファイルを選びます。同じファイルを二度取り込んでも手書きは二重になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 버전의 설정에서 ‘手書きを書き出す（iPad アプリ用）’(iPad 앱용 손글씨 내보내기)을 실행한 다음, 그 파일을 선택해요. 같은 파일을 두 번 가져와도 손글씨가 중복되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos ajustes da versão web, use “手書きを書き出す（iPad アプリ用）” (exportar a escrita à mão para o app de iPad) e depois escolha esse arquivo. Importar o mesmo arquivo duas vezes não duplica a escrita à mão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在网页版的设置中使用“手書きを書き出す（iPad アプリ用）”（导出手写内容，供 iPad App 使用），然后选择该文件。同一文件导入两次，手写内容也不会重复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在網頁版的設定中使用「手書きを書き出す（iPad アプリ用）」（匯出手寫內容，供 iPad App 使用），然後選擇該檔案。同一個檔案匯入兩次，手寫內容也不會重複。"
          }
        }
      }
    },
