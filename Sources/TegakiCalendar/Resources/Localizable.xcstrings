    "settings.data.erase.warning.cloud" : {
      "comment" : "2 回目の確認の本文。iCloud の分も消えるとき",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann nicht rückgängig gemacht werden. Auch die Handschrift auf Ihren anderen iPads und iPhones wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone. Handwriting on your other iPads and iPhones is also erased."
          }
