    "import.confirmLarge.text" : {
      "comment" : "問いの本文",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Import haben einige Seiten mehr als %1$@ Striche (%2$@). Diese Version zeigt alle an, aber Geräte mit einer älteren Version zeigen nur einen Teil. Importieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After importing, some pages have more than %1$@ strokes (%2$@). This version shows them all, but devices with an older version do not show some of them. Import anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al importar, algunas páginas tendrán más de %1$@ trazos (%2$@). Esta versión los muestra todos, pero los dispositivos con una versión anterior solo muestran una parte. ¿Importar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’importation, certaines pages auront plus de %1$@ traits (%2$@). Cette version les affiche tous, mais les appareils avec une ancienne version n’en affichent qu’une partie. Importer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l’importazione, alcune pagine avranno più di %1$@ tratti (%2$@). Questa versione li mostra tutti, ma i dispositivi con una versione precedente ne mostrano solo una parte. Importare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込むと、線が %1$@ 本を超えるページがあります（%2$@）。この版では全部表示されますが、古い版の端末ではその一部が表示されません。取り込みますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오면 선이 %1$@개를 넘는 페이지가 생겨요(%2$@). 이 버전에서는 모두 표시되지만, 이전 버전의 기기에서는 일부가 표시되지 않아요. 가져올까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de importar, algumas páginas terão mais de %1$@ traços (%2$@). Esta versão mostra todos, mas dispositivos com uma versão anterior mostram só uma parte. Importar?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入后，有些页面的线条会超过 %1$@ 条（%2$@）。此版本会全部显示，但在装有旧版本的设备上，其中一部分不会显示。要导入吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入後，有些頁面的線條會超過 %1$@ 條（%2$@）。此版本會全部顯示，但在安裝舊版本的裝置上，其中一部分不會顯示。要匯入嗎？"
          }
        }
      }
    },
