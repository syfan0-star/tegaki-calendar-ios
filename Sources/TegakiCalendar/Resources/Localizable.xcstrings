    "settings.weekStart.confirm.title.monday" : {
      "comment" : "切り替えの確認の題名。英語 Start weeks on Monday?",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochen am Montag beginnen?"
          }
        },
        "en" : {
          "stringUnit" : {
