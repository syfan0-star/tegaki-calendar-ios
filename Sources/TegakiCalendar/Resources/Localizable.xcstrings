    "account.eraseMessage" : {
      "comment" : "同じ確認の本文",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Handschrift auf diesem Gerät wird gelöscht, und Sie beginnen mit dem neuen Account. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All handwriting on this device is erased, and you start with the new account. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrará toda la escritura a mano de este dispositivo y empezará con la cuenta nueva. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute l’écriture manuscrite de cet appareil sera effacée, et vous commencerez avec le nouveau compte. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutta la scrittura a mano su questo dispositivo verrà cancellata e inizierà con il nuovo account. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の手書きを全て消して、新しいアカウントで始めます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 손글씨를 모두 지우고 새 계정으로 시작해요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda a escrita à mão deste dispositivo será apagada e você começará com a conta nova. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将抹掉此设备上的所有手写内容，并用新账户开始。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除這部裝置上的所有手寫內容，並以新帳號開始。此操作無法復原。"
          }
        }
      }
    },
    "account.eraseTitle" : {
      "comment" : "手書きを消す前のもう一度の確認の題名",
