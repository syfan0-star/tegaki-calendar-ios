    "notice.calendar.denied" : {
      "comment" : "見出しの下の案内（2 行まで）。「フルアクセス」は iOS の「設定」のカレンダーの項目の、その言語の表記に合わせる",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Termine anzuzeigen, stellen Sie Kalender in den Einstellungen auf „Voller Zugriff“."
          }
        },
        "en" : {
          "stringUnit" : {
