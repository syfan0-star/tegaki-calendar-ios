    "account.message" : {
      "comment" : "同じ問いの本文",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handschrift auf diesem Gerät gehört zu dem iCloud-Account, der zuvor synchronisiert wurde. Mit dem jetzt angemeldeten Account beginnen? Wenn Sie die Handschrift behalten, wird sie an die iCloud des neuen Accounts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The handwriting on this device belongs to the iCloud account it synced with before. Start using the account you are signed in to now? If you keep the handwriting, it is sent to the iCloud of the new account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La escritura a mano de este dispositivo pertenece a la cuenta de iCloud que se sincronizaba antes. ¿Empezar con la cuenta con la que ha iniciado sesión ahora? Si conserva la escritura, se enviará al iCloud de la cuenta nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écriture manuscrite de cet appareil appartient au compte iCloud synchronisé auparavant. Commencer avec le compte actuellement connecté ? Si vous la gardez, elle sera envoyée dans l’iCloud du nouveau compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scrittura a mano su questo dispositivo appartiene all’account iCloud sincronizzato in precedenza. Iniziare con l’account con cui ha ora effettuato l’accesso? Se mantiene la scrittura, verrà inviata all’iCloud del nuovo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の手書きは、前に同期していた iCloud アカウントのものです。いまサインインしているアカウントで使い始めますか？ 手書きを残すと、新しいアカウントの iCloud に送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 손글씨는 이전에 동기화하던 iCloud 계정의 것이에요. 지금 로그인한 계정으로 시작할까요? 손글씨를 남기면 새 계정의 iCloud로 보내져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A escrita à mão deste dispositivo pertence à conta do iCloud sincronizada antes. Começar com a conta em que você está conectado agora? Se mantiver a escrita, ela será enviada para o iCloud da conta nova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的手写内容属于之前同步的 iCloud 账户。要用当前登录的账户开始使用吗？如果保留手写内容，它们会被发送到新账户的 iCloud。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部裝置上的手寫內容屬於先前同步的 iCloud 帳號。要以目前登入的帳號開始使用嗎？如果保留手寫內容，它們會傳送到新帳號的 iCloud。"
          }
        }
      }
    },
