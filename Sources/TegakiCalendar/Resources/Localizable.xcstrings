        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour afficher les évènements, réglez Calendriers sur « Accès complet » dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrare gli eventi, imposti Calendari su “Accesso completo” in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定を表示するには設定でカレンダーを「フルアクセス」にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정을 표시하려면 설정에서 캘린더를 ‘전체 접근’으로 설정해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para exibir os eventos, ajuste Calendários para “Acesso Total” em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要显示日程，请在“设置”中将日历设为“完全访问”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
