    "event.recurringNote" : {
      "comment" : "繰り返しの予定を編集するときの注記。「この回だけ」「以降すべて」は recurrence.thisEvent・recurrence.futureEvents と同じ語で",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein wiederkehrender Termin. Beim Sichern oder Löschen wählen Sie „Nur dieser Termin“ oder „Dieser und alle folgenden“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a repeating event. When you save or delete it, you choose “This Event Only” or “This and Future Events”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un evento que se repite. Al guardar o eliminar, elija “Solo este evento” o “Este y los siguientes”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évènement périodique. Pour enregistrer ou supprimer, choisissez « Celui-ci seulement » ou « Celui-ci et les suivants »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un evento ripetuto. Quando salva o elimina, scelga “Solo questo evento” o “Questo e i successivi”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返しの予定です。保存・削除のときに「この回だけ」か「以降すべて」を選びます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반복 일정이에요. 저장하거나 삭제할 때 ‘이번만’ 또는 ‘이후 모두’를 선택해요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um evento repetido. Ao salvar ou apagar, escolha “Só este evento” ou “Este e os seguintes”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是重复日程。保存或删除时，请选择“仅此次”或“此次及以后”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是重複行程。儲存或刪除時，請選擇「僅此次」或「此次及之後」"
          }
        }
      }
    },
