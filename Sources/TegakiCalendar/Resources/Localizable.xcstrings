    "settings.info.footer" : {
      "comment" : "情報の節の説明",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Strichzahl stammt von den auf diesem Gerät gesicherten Seiten (es wird nichts gesendet). Eine Seite fasst bis zu %@ Striche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stroke counts come from the pages saved on this device (nothing is sent anywhere). One page can hold up to %@ strokes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de trazos sale de las páginas guardadas en este dispositivo (no se envía a ningún sitio). Una página admite hasta %@ trazos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre de traits vient des pages enregistrées sur cet appareil (rien n’est envoyé). Une page peut contenir jusqu’à %@ traits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di tratti viene dalle pagine salvate su questo dispositivo (non viene inviato nulla). Una pagina può contenere fino a %@ tratti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線の数は、この端末に保存されているページを数えたものです（どこにも送りません）。1 ページに書ける線は %@ 本までです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선의 수는 이 기기에 저장된 페이지를 센 거예요(어디로도 보내지 않아요). 한 페이지에 쓸 수 있는 선은 %@개까지예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem de traços vem das páginas salvas neste dispositivo (nada é enviado). Uma página aceita até %@ traços."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线条数量统计的是保存在此设备上的页面（不会发送到任何地方）。每页最多可写 %@ 条线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線條數量統計的是儲存在這部裝置上的頁面（不會傳送到任何地方）。每頁最多可寫 %@ 條線。"
          }
        }
      }
    },
