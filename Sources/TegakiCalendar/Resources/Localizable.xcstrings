          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaines réglées sur lundi selon la région de l’appareil. Votre écriture des semaines du dimanche n’est pas supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settimane impostate su lunedì in base alla zona del dispositivo. La scrittura delle settimane di domenica non è eliminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の地域に合わせて、週の始まりを月曜にしました。日曜始まりの週の手書きは消えていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 지역에 맞춰 한 주의 첫째 날을 월요일로 설정했어요. 일요일 시작의 주 손글씨는 지워지지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A semana começa na segunda-feira pela região do dispositivo. A escrita das semanas de domingo não foi apagada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已根据设备的地区将一周的第一天设为周一。周日开始的周手写内容没有消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已依照裝置的地區將一週的第一天設為週一。週日開始的週手寫內容沒有消失。"
          }
        }
      }
    },
    "toast.weekStart.regionChanged.sunday" : {
